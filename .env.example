APP_ENV=development

# Local PostgreSQL (used by docker-compose.yml)
POSTGRES_USER=expirywatch_user
# Use a long, URL-safe password (or URL-encode special characters in DATABASE_URL).
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password
POSTGRES_DB=expirywatch_db
POSTGRES_PORT=5444

# Must use the same user, password, port and database name as above.
DATABASE_URL=postgresql+psycopg://expirywatch_user:replace-with-a-long-random-url-safe-password@localhost:5444/expirywatch_db

# Set to true to print every SQL statement (debugging only)
SQL_ECHO=false
